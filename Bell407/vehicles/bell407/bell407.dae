  <library_effects>
    <effect id="bell407_crosshair-effect">
      <profile_COMMON>
        <newparam sid="crosshair_png-surface">
          <surface type="2D">
            <init_from>crosshair_png</init_from>
          </surface>
        </newparam>
        <newparam sid="crosshair_png-sampler">
          <sampler2D>
            <source>crosshair_png-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="common">
          <lambert>
            <emission>
              <color sid="emission">0 0 0 1</color>
            </emission>
            <diffuse>
              <texture texture="crosshair_png-sampler" texcoord="UVMap"/>
            </diffuse>
            <index_of_refraction>
              <float sid="ior">1.45</float>
            </index_of_refraction>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
